<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="/favicon.png" type="image/png">
 
    <script type="text/javascript">
      window.RAILS_ENV = '<%= Rails.env %>'
      window.VERSION = '<%= ENV['RAILWAY_GIT_COMMIT_SHA'] %>'
    </script>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= vite_client_tag %>
    <%= vite_javascript_tag 'browser' %>

    <%= vite_global_style_tag %>
  
    <%= inertia_headers %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
