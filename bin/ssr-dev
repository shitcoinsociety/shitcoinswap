#!/bin/sh

sigint_handler()
{
  kill $PID
  exit
}

trap sigint_handler SIGINT

while true; do
  vite build --ssr > /dev/null
  vite ssr &
  PID=$!
  if [ "$(uname)" = "Linux" ]; then
    inotifywait -e modify -e move -e create -e delete -e attrib -r app/frontend
  elif [ "$(uname)" = "Darwin" ]; then
    fswatch -1 -r app/frontend
  fi
  kill $PID
done